doctype html
html(lang="en")
  head
    title= title
    meta(name="viewport", content="width=device-width", initial-scale="1")
    
    if env === 'development'
      script(src="/ioos-ui-components.min.js")
    else
      script(src="https://dgd6r9iiqa8y9.cloudfront.net/ioos-ui-components-dev.min.js")

    - var subdirPath = siteSubdirectory ? `/${siteSubdirectory}` : ''
    
    script(src=`${subdirPath}/js/main.min.js`)
    link(rel="icon", href=`${subdirPath}/images/favicon.ico`, type="image/x-icon")
    link(rel="stylesheet", href=`${subdirPath}/css/main.min.css`, type="text/css")
    link(rel="stylesheet", href=`${subdirPath}/css/roboto-slab.css`, integrity="sha384-2MyEKmXHnfNeMg3ylCXNjrxs0NFuvZDJhC068tS1vNJmIGTrhkHZzWjnFjvMxSzg", crossorigin="anonymous", type="text/css")
  
  body
    include ./header.pug
    .page-content
      block body
      include ./feedback.pug
    include ./footer.pug
