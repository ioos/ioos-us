{
  "name": "ioos-us",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch views --watch sites --watch css --watch js --watch assets.json --watch build.js --ext pug,json,js,css,html --exec 'node build.js'",
    "start": "concurrently \"npm run build --watch\" \"npm run serve\"",
    "serve": "browser-sync start --server static --files 'static/**/*' --no-ui",
    "build": "node build.js"
  },
  "license": "MIT",
  "dependencies": {
    "body-parser": "~1.19.0",
    "bootstrap": "^3.3.6",
    "cookie-parser": "~1.4.5",
    "debug": "~4.1.1",
    "dotenv": "^16.4.7",
    "font-awesome": "^4.5.0",
    "jquery": "^3.6.0",
    "masonry-layout": "^4.2.2",
    "morgan": "1.10.0",
    "outlayer": "^2.1.0",
    "pug": "^2.0.4",
    "serve-favicon": "~2.5.0",
    "underscore": "^1.13.6",
    "universal-analytics": "^0.4.20"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "clean-css": "^5.3.3",
    "concurrently": "^9.1.0",
    "desandro-matches-selector": "^2.0.0",
    "ev-emitter": "^1.0.0",
    "fizzy-ui-utils": "^2.0.7",
    "fs-extra": "^11.2.0",
    "get-size": "^2.0.2",
    "nodemon": "^3.1.7",
    "uglify-js": "^3.19.3"
  }
}
